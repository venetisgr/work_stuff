{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "zeus-trials",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": { "entry": "splash.html", "height": "tall" },
      "game": { "entry": "game.html" }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": true
  },
  "menu": {
    "items": [
      {
        "label": "Create Zeus: Trial of Olympus post",
        "description": "Posts the game to this subreddit",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on-app-install"
  }
}
