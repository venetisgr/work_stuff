{
  "name": "zeus-trial-of-olympus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zeus: Trial of Olympus — a 75-second Three.js arena survival game for Reddit (Devvit Web).",
  "scripts": {
    "dev:client": "vite --config vite.client.config.ts",
    "build:client": "vite build --config vite.client.config.ts",
    "build:server": "vite build --config vite.server.config.ts",
    "build": "npm run build:client && npm run build:server",
    "typecheck": "tsc --noEmit",
    "inspect:glb": "node tools/inspect-glb.mjs",
    "devvit:playtest": "devvit playtest",
    "devvit:upload": "npm run build && devvit upload"
  },
  "dependencies": {
    "@devvit/web": "^0.14.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "devvit": "^0.14.7",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
