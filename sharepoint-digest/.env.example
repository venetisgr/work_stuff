# Copy this file to .env and fill it in. Never commit .env.

# --- SharePoint (read through Microsoft Graph) ------------------------------
# Not needed if you read synced copies instead (local_path in folders.toml, or --local-dir).
# The site that holds the folders in folders.toml (site address only, no library or page path),
# and the document library the folder paths start from ("Documents" is the default library).
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/YourSite
SHAREPOINT_LIBRARY=Documents

# How to sign in to Microsoft Graph:
#   app         - app registration + client secret. Needs the Graph *application* permission
#                 Sites.Read.All (or Sites.Selected plus access to this site), with admin consent.
#   device_code - sign in as yourself through a browser code. Needs an app registration with
#                 "Allow public client flows" on and the *delegated* permission Sites.Read.All.
#                 Leave AZURE_CLIENT_SECRET empty.
#   default     - DefaultAzureCredential: managed identity, Azure CLI login, or a certificate
#                 via AZURE_CLIENT_CERTIFICATE_PATH.
GRAPH_AUTH_MODE=app
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Azure AI Foundry (GPT model) ------------------------------------------
# Endpoint from the resource's overview page, e.g. https://my-resource.openai.azure.com/
# or https://my-resource.services.ai.azure.com/ (the resource name alone also works).
# You can also paste a deployment's Target URI (.../openai/deployments/<name>/chat/completions?...);
# FOUNDRY_DEPLOYMENT can then stay empty.
FOUNDRY_ENDPOINT=
# Name of your GPT *deployment* (Foundry portal > Models + endpoints), e.g. gpt-4.1.
FOUNDRY_DEPLOYMENT=
# Key from the resource's "Keys and Endpoint" page. Leave empty to sign in with Entra ID
# instead; that uses the AZURE_* app above if set, otherwise `az login` or a managed identity,
# and the identity needs the "Cognitive Services OpenAI User" role on the Foundry resource.
FOUNDRY_API_KEY=

# --- Optional tuning --------------------------------------------------------
# Reasoning models only (e.g. gpt-5, o3): how much the model reasons, e.g. low or medium.
# Leave unset for gpt-4o and gpt-4.1, which reject it.
# FOUNDRY_REASONING_EFFORT=low
# Cap on each reply's length in tokens (default: the model's own limit).
# LLM_MAX_OUTPUT_TOKENS=8000
# Documents longer than this many characters (about 4 per token) are summarized in parts.
# LLM_MAX_INPUT_CHARS=200000
