# The Next.js front end on Vercel. Copy to .env.local for `npm run dev` / `npm start`; on Vercel set both under
# Settings > Environment Variables for Production and Preview. Both are server-only: never prefix them with
# NEXT_PUBLIC_ (that would put them in the pages' JavaScript).

# The Fly app's address, without a path: https://<your-app>.fly.dev (http only for 127.0.0.1 / localhost).
DIP_API_ORIGIN=http://127.0.0.1:8080

# The same value as the Fly app's PROXY_SECRET (at least 32 characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DIP_PROXY_SECRET=
