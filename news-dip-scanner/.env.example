# Copy this file to .env and fill it in. Never commit .env.
# Variables already set in your real environment win over this file.

# --- Language model ---------------------------------------------------------
# Which service reads the news and writes the analyses: openai (default), azure or anthropic.
# Two models are used: a small, cheap one for triage (which companies does each article affect?)
# and a stronger one for the fear-vs-fundamentals analysis of each dip.
LLM_PROVIDER=openai

# OpenAI (the ChatGPT API, what the original Reddit author used).
# Key from https://platform.openai.com/api-keys. Defaults: gpt-5-mini for triage, gpt-5 for analysis.
OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway or local server (e.g. http://localhost:11434/v1 for Ollama).
# OPENAI_BASE_URL=

# Model names (for azure: your *deployment* names). Leave empty for the defaults above.
# LLM_TRIAGE_MODEL=gpt-5-mini
# LLM_ANALYSIS_MODEL=gpt-5

# --- Alternative: Azure AI Foundry (LLM_PROVIDER=azure) ----------------------
# Endpoint from the resource's overview page, e.g. https://my-resource.openai.azure.com/
# (the resource name alone also works, and so does a deployment's Target URI).
# FOUNDRY_ENDPOINT=
# Deployment used for both steps, unless LLM_TRIAGE_MODEL / LLM_ANALYSIS_MODEL name two deployments.
# FOUNDRY_DEPLOYMENT=
# Key from "Keys and Endpoint". Leave empty to sign in with Entra ID instead (az login, a managed
# identity or AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET); needs pip install -e ".[azure]"
# and the "Cognitive Services OpenAI User" role on the resource.
# FOUNDRY_API_KEY=

# --- Alternative: Anthropic Claude (LLM_PROVIDER=anthropic) ------------------
# Needs pip install -e ".[anthropic]". Defaults: claude-haiku-4-5 for triage, claude-sonnet-5 for analysis.
# ANTHROPIC_API_KEY=

# --- Optional model tuning ---------------------------------------------------
# Reasoning effort for models that support it: OpenAI gpt-5 family minimal/low/medium/high;
# Claude low/medium/high/xhigh/max (not sent to Haiku). Reasoning is billed as output tokens.
# LLM_REASONING_EFFORT applies to both models; the per-step settings override it for one of them.
# Recommended: low for triage (it only maps headlines to companies, every few minutes all day);
# keep the analysis at the model's default or medium. Leave all three unset for models without
# reasoning (e.g. a gpt-4o deployment or most local servers), which reject the setting.
# LLM_REASONING_EFFORT=low
# LLM_TRIAGE_REASONING_EFFORT=low
# LLM_ANALYSIS_REASONING_EFFORT=medium
# Cap on each reply's length in tokens (default: the model's own limit; 16000 for Claude).
# LLM_MAX_OUTPUT_TOKENS=8000

# --- SEC (US company filings) ------------------------------------------------
# The SEC asks every client to name a contact in its User-Agent. With this set, the analysis gets
# recent quarterly figures of US-listed companies, and the SEC 8-K feed in feeds.toml works
# (without it that feed is skipped: sec.gov answers 403).
SEC_USER_AGENT=
# e.g. SEC_USER_AGENT=Jane Doe jane@example.com

# --- Where data goes ---------------------------------------------------------
# Database, reports/ and cache/ (default: ./data).
# DATA_DIR=data
# Other copies of the config files (default: ./scanner.toml or ./feeds.toml, else the project's).
# SCANNER_CONFIG=scanner.toml
# FEEDS_FILE=feeds.toml

# --- Times --------------------------------------------------------------------
# The time zone of every time you read: reports, alerts, summaries, notes and the log (default UTC).
# An IANA name; everything is still stored in UTC. The model's daily use counts from 00:00 UTC.
# DISPLAY_TZ=Europe/Athens

# --- Notifications (all optional) -------------------------------------------
# Opportunities that pass [alerts] in scanner.toml are sent to every channel set up below.
# A channel that is only half set up is skipped with a warning naming what's missing.

# Email over SMTP. Port 587 uses STARTTLS, port 465 implicit TLS. SMTP_FROM defaults to SMTP_USER
# when that is an email address. EMAIL_TO takes several addresses separated by commas.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=an-app-password
# SMTP_FROM=you@gmail.com
# SMTP_STARTTLS=true
# EMAIL_TO=you@gmail.com

# A chat webhook: slack (incoming webhook), discord (channel webhook) or generic
# (a JSON POST of {"subject", "markdown", "html"}, e.g. for n8n, Zapier or your own script).
# WEBHOOK_URL=https://hooks.slack.com/services/...
# WEBHOOK_FORMAT=slack

# Telegram: create a bot with @BotFather, send it a message, then find your chat id at
# https://api.telegram.org/bot<token>/getUpdates
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Website (dip-scanner serve; the command line doesn't need these) ----------------------------
# Website users get their alerts through the same SMTP server (to their account's address) and the
# same Telegram bot (to their own chat id); set those above to offer email and Telegram alerts.
# A random secret the website needs (at least 32 characters). Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# The website's address: invite and password links (also those `dip-scanner users` prints) use it.
# BASE_URL=https://my-dips.fly.dev
# The session cookie only travels over https (default true); false only for http://localhost tests.
# COOKIE_SECURE=true
# Manual analyses ("Analyse now") a member may start in 24 hours; admins have no limit (default 5).
# ANALYZE_LIMIT_PER_USER=5
# Run the scanner inside the website process (default true); false serves the pages only.
# SCANNER_ENABLED=true
